# ==============================================================================
# Tex AI - Environment Configuration Example
# Copy this file to .env.local for local development or .env for Docker deployments
# ==============================================================================

NODE_ENV=production
PORT=3050

# LLM Provider selection: 'gemini', 'claude', or 'hybrid'
LLM_PROVIDER=gemini

# Google Gemini API Configuration (Default Free Tier)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Anthropic Claude API Configuration (Optional)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-5-sonnet-20241022

# Security & Access Control
# Token required on the web interface to establish an authenticated session
ACCESS_TOKEN=YourSecureCorporateToken2026!

# Cryptographic secret used for HMAC-SHA256 session cookie signing (min 32 characters)
AUTH_SECRET=generate_a_random_32_character_secret_key_here

# Hybrid / Local Bridge URL (Optional - only if using local PC inference bridge)
# PC_BRIDGE_URL=http://localhost:8099
