# ==============================================================================
# Tex AI - Variables de entorno de ejemplo
# Copiá este archivo a .env.local (desarrollo) o .env (Docker) y completalo.
# ==============================================================================

NODE_ENV=production
PORT=3050

# Claude API (obligatoria)
ANTHROPIC_API_KEY=your_anthropic_api_key_here
# Modelo de generación y modelo rápido para reescritura y reranking
CLAUDE_MODEL=claude-opus-5-5
RAG_FAST_MODEL=claude-haiku-5-5

# Opcional: búsqueda densa con embeddings de Voyage AI (el proveedor que recomienda
# Anthropic para usar con Claude). Sin esta clave el pipeline usa BM25 + reranking.
# VOYAGE_API_KEY=your_voyage_api_key_here

# Acceso a la interfaz: token para iniciar sesión (sin valor, nadie puede iniciar sesión)
ACCESS_TOKEN=replace_with_a_long_random_token

# Secreto para firmar las cookies de sesión con HMAC-SHA256 (32+ caracteres aleatorios)
AUTH_SECRET=replace_with_at_least_32_random_characters
